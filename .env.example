DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret-before-deploying
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000
# Hosted PostgreSQL connection (takes precedence over POSTGRES_HOST):
# DATABASE_URL=postgresql://user:password@host:5432/finpilot?sslmode=require
# DATABASE_REQUIRE_SSL=true
# Render Blueprint supplies SECRET_KEY_SEED and DATABASE_URL automatically.
# TRUST_PROXY_SSL_HEADER=true  # Only behind an ingress that strips spoofed headers
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
# PostgreSQL required for production; omit POSTGRES_HOST for local SQLite
# POSTGRES_HOST=localhost
POSTGRES_DB=finpilot
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=replace-me
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# Owner platform key: server-side only. Never paste into a browser form.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=
XAI_TIMEOUT_SECONDS=30
XAI_MAX_OUTPUT_TOKENS=1800
XAI_TEMPERATURE=0.2
# Groq alternative: set FINPILOT_AI_PROVIDER=groq and add your server-side gsk key.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_OUTPUT_TOKENS=1800
GROQ_TEMPERATURE=0.2
FINPILOT_AI_ENABLED=true
FINPILOT_AI_PROVIDER=xai
FINPILOT_AI_FALLBACK_ENABLED=true
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
